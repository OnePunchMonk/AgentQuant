    {"id": "eval_02", "expected_tool": "lookup_facts", "initial_tool": "lookup_status", "query": "beta", "limit": 2, "expected": ["beta:fact-1", "beta:fact-2"], "initial_arguments": {"query": "beta", "limit": 99}},
