    {"id": "eval_04", "expected_tool": "lookup_status", "initial_tool": "lookup_status", "asset": "ETH-USD", "expected": {"asset": "ETH-USD", "status": "available"}, "initial_arguments": {"asset": "ETH-USD"}},
    {"id": "eval_05", "expected_tool": "lookup_facts", "initial_tool": "lookup_status", "query": "gamma", "limit": 1, "repairable": false, "expected": ["gamma:fact-1"], "initial_arguments": {"unrecognized": true}}
